# Copie este archivo como .env y complete los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Conexión a PostgreSQL en Supabase (sección 19.3 del documento)
DB_HOST=tu-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.tu-referencia-de-proyecto
DB_PASSWORD=tu_contraseña_real
DB_SSLMODE=require

# Opcional: si se define, reemplaza a las variables DB_* (es la que usaba cargar.py)
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres?sslmode=require

# Clave para firmar las sesiones del tablero. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie_esta_clave

# Aplicación
PORT=8050
DASH_DEBUG=false
MINUTOS_CACHE=5
